{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{"type": "host", "value": "decodeeestudiooo\\.vercel\\.app"}],
      "destination": "https://decodeeestudiooo.chrbuilds.dev/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "decodeeestudiooo\\.vercel\\.app"}],
      "destination": "https://decodeeestudiooo.chrbuilds.dev/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "has": [{"type": "host", "value": "decodeeestudiooo\\.chrbuilds\\.dev"}],
      "headers": [{"key": "Link", "value": "<https://decodeeestudiooo.chrbuilds.dev/>; rel=\"canonical\""}]
    }
  ]
}
