{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{"type": "host", "value": "brewday-delta\\.vercel\\.app"}],
      "destination": "https://brewday-delta.chrbuilds.dev/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "brewday-delta\\.vercel\\.app"}],
      "destination": "https://brewday-delta.chrbuilds.dev/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "has": [{"type": "host", "value": "brewday-delta\\.chrbuilds\\.dev"}],
      "headers": [{"key": "Link", "value": "<https://brewday-delta.chrbuilds.dev/>; rel=\"canonical\""}]
    }
  ]
}
